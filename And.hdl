// File name: projects/01/And.hdl

/**
 * And gate: 
 * out = 1 if (a == 1 and b == 1)
 *       0 otherwise
 */

CHIP And {
    IN a, b;
    OUT out;

    PARTS:
    // An AND gate is a NOT(NAND(a, b)), therefore, the NOT chip from Task 1.1 can be used here to make the AND gate.

    // Storing the output of the NAND gate in nandOut.
    Nand(a = a, b = b, out = nandOut);

    // Using the NOT gate to flip the output.
    Not(in = nandOut, out = out);
}
