// File name: projects/01/DMux.hdl

/**
 * Demultiplexor:
 * {a, b} = {in, 0} if sel == 0
 *          {0, in} if sel == 1
 */

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    // A demultiplexor will take in one input and a selector. If sel = 0, input goes to a and b = 0. If sel = 1, input goes to b and a = 0.

    // Similar to the Mux chip, passing the selector through a NOT chip would ensure that the appropriate wiring is conducted.
    Not(in = sel, out = notSel);

    And(a = in, b = notSel, out = a);
    And(a = in, b = sel, out = b);
}
